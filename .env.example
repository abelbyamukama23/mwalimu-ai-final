# Mwalimu — Local environment template
# Copy this file to .env and adjust values for your local environment.

# -----------------------------------------------------------------------------
# Platform API (Django)
# -----------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=platform_api.settings

# PostgreSQL — system of record
DATABASE_URL=postgres://mwalimu:mwalimu@localhost:5432/mwalimu
DATABASE_NAME=mwalimu
DATABASE_USER=mwalimu
DATABASE_PASSWORD=mwalimu
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Object storage — original resource files
# Configure for MinIO, AWS S3, or another S3-compatible store.
OBJECT_STORAGE_BACKEND=platform_api.apps.resources.storage.S3Storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=mwalimu
OBJECT_STORAGE_SECRET_KEY=change-me
OBJECT_STORAGE_BUCKET=mwalimu-resources
OBJECT_STORAGE_REGION=us-east-1

# Resource upload settings (bytes)
RESOURCE_MAX_UPLOAD_SIZE=104857600

# -----------------------------------------------------------------------------
# Agent Service (FastAPI)
# -----------------------------------------------------------------------------
AGENT_SERVICE_HOST=0.0.0.0
AGENT_SERVICE_PORT=8001
AGENT_SERVICE_URL=http://localhost:8001

# Platform API location used by the Agent Service to fetch context/state.
PLATFORM_API_URL=http://localhost:8000
PLATFORM_API_INTERNAL_TOKEN=change-me-internal-token

# Model Gateway — provider-neutral LLM routing
MODEL_GATEWAY_URL=http://localhost:8080
MODEL_GATEWAY_API_KEY=change-me

# Default LLM for the agent runtime
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_LLM_PROVIDER=openai

# -----------------------------------------------------------------------------
# Asynchronous processing (Celery + Redis)
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# Redis — ephemeral state, locks, result backend
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# pgvector
# -----------------------------------------------------------------------------
# Embeddings and vector search are provided by PostgreSQL + pgvector.
# No separate vector database is required.

# Embedding model configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
